# Collage worker: Dockerfile.worker + rembg (subject cut-outs) + OpenCV (face-aware crops, pulled in by rembg).
# Python 3.12: onnxruntime/rembg wheels are the safest there. The u2netp model is baked in at build time so the
# first job does not download ~5 MB at runtime, and it runs as the non-root user.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MALLOC_ARENA_MAX=2 \
    U2NET_HOME=/app/.u2net \
    OMP_NUM_THREADS=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libraqm0 libgomp1 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-worker.txt requirements-collage.txt ./
RUN pip install --no-cache-dir -r requirements-collage.txt \
    && python -c "from rembg import new_session; new_session('u2netp')"

COPY . .

RUN useradd --create-home --uid 10001 vibeos && chown -R vibeos:vibeos /app
USER vibeos

CMD ["python", "worker.py"]
